    {
      "role": "polyester",
      "from": "printed",
      "to": "heatpress",
      "notifyWhenEmpty": true
    },
    {
      "role": "rollpress",
      "from": "heatpress",
      "to": "qc",
      "notifyWhenEmpty": true
    },
    {
      "role": "qc",
      "from": "heatpress",
      "to": "qc",
      "notifyWhenEmpty": false
    }
  ]
