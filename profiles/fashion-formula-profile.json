    "ripError": "AUTOMATION_WORKFLOW_ERROR",
    "customOrder": "AUTOMATION_WORKFLOW_MINERVA"
  },
  "sewingCompanies": [
    "Olya",
    "Vagabond"
  ],
  "integrations": {
    "shopify": {
      "storeHandle": "fashionformulauk"
    }
  },
  "features": {
    "customOrders": true,
    "analytics": true,
    "ripErrors": true,
    "labelPrinting": true,
    "shopify": true,
    "sewing": true
  },
  "scanRules": [
    {
      "role": "cotton",
      "from": "printed",
      "to": "heatpress",
      "notifyWhenEmpty": true
