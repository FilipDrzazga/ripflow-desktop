      "color": {
        "bg": "#E6F1FB",
        "text": "#0C447C"
      }
    },
    {
      "code": "YOKO",
      "materialClass": "Polyesters",
      "hotfolder": "AUTOMATION_WORKFLOW_POLY",
      "color": {
        "bg": "#EEEDFE",
