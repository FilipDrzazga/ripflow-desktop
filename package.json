{
  "name": "ripflow-desktop",
  "private": true,
  "version": "1.0.4",
  "author": "Filip Drzazga",
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "dev:electron": "electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c auto \"npm run dev:vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build": "vite build",
    "build:dist": "vite build && dotenv -e .env -- electron-builder --win --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.ripflow.desktop",
    "productName": "RipFlow Desktop",
    "files": [
      "dist/**/*",
      "src/electron/**/*",
      "src/shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/ui/assets/image/maake_logo_256.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "FilipDrzazga",
      "repo": "ripflow-desktop",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.6.2",
    "bwip-js": "^4.11.1",
    "electron-store": "^11.0.2",
    "fuse.js": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.3"
  }
}
